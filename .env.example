# ============================================================
# AI Codebase Architecture & Onboarding Analyzer
# Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME=ai-code-analyzer
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ============================================================
# 1. PostgreSQL (Neon / Supabase / Local)
# ============================================================
# Paste your full connection URL from Neon or Supabase dashboard:
# Example: postgresql://neondb_owner:npg_xyz@ep-cool-fog-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=paste_your_postgres_connection_url_here

# ============================================================
# 2. Redis (Upstash / Local)
# ============================================================
# Paste your Upstash Redis REST URL:
# Example: rediss://default:AX123xyz@us1-cool-seal-12345.upstash.io:6379
REDIS_URL=paste_your_redis_url_here
CELERY_BROKER_URL=paste_your_redis_url_here
CELERY_RESULT_BACKEND=paste_your_redis_url_here

# ============================================================
# 3. Qdrant Cloud (Vector Database)
# ============================================================
# Paste your Qdrant Cloud cluster URL and API key:
# Example URL: https://d1234-5678.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_URL=paste_your_qdrant_cloud_url_here
QDRANT_API_KEY=paste_your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=code_embeddings

# ============================================================
# 4. OpenAI (Embedding Generation)
# ============================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- JWT Secrets (for future auth) ---
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
